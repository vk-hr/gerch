{
  "name": "gerch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "lint": "oxlint",
    "format": "oxfmt .",
    "check": "oxlint && oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run --project=unit --passWithNoTests",
    "test:watch": "bun --bun vitest --project=unit",
    "test:live": "bun --bun vitest run --project=live --passWithNoTests",
    "test:e2e": "playwright test",
    "fixtures:record": "bun run scripts/record-fixtures.ts"
  },
