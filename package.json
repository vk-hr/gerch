    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.14.0",
    "@tanstack/react-hotkeys-devtools": "^0.10.1",
