# Copy to .env and fill in. Schemas live in src/env.ts —
# every variable you list here needs a matching zod schema there.

# Server-only (never shipped to the browser).
# EXAMPLE_SERVER_SECRET="change-me-at-least-32-chars-long!!"

# NixOS search Elasticsearch backend. The credentials are published in the
# search.nixos.org frontend bundle; without them nixpkgs search degrades.
# SERVER_NIX_ES_URL="https://search.nixos.org/backend"
# SERVER_NIX_ES_USERNAME=""
# SERVER_NIX_ES_PASSWORD=""

# Identifying User-Agent for upstream registry requests.
# SERVER_USER_AGENT="gerch (+https://github.com/<you>/gerch)"

# Client-exposed (must be prefixed with VITE_).
# VITE_APP_URL="http://localhost:3000"

# Set to bypass env validation (e.g. docker image builds).
# SKIP_ENV_VALIDATION=1
