# Copy to .env and fill in. Schemas live in src/env.ts —
# every variable you list here needs a matching zod schema there.

# Server-only (never shipped to the browser).
# EXAMPLE_SERVER_SECRET="change-me-at-least-32-chars-long!!"

# Client-exposed (must be prefixed with VITE_).
# VITE_APP_URL="http://localhost:3000"

# Set to bypass env validation (e.g. docker image builds).
# SKIP_ENV_VALIDATION=1
